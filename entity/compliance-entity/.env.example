# MySQL connection string
# Format: user:password@tcp(host:port)/dbname?parseTime=true
# With no tls= parameter the service defaults to verified TLS; a local MySQL
# without TLS must append &tls=false.
DB_DSN=<dbuser>:<dbpassword>@tcp(<host-ip>:3306)/<dbname>?parseTime=true

# HTTP listen port (default: 8080)
SERVER_PORT=8080
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=