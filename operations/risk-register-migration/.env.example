# risk-register-import — local environment
#
# Every key here maps 1:1 to a field on Config in main.go and to a Choreo
# Manual Task config/secret of the same name (see .choreo/component.yaml) —
# loadConfig reads flags first, then falls back to these env vars, so a local
# `go run` and a Choreo run are configured the same way.
#
# Usage:
#   set -a && source .env && set +a
#   go run . -input ./risks.csv -migration-date 2026-09-15            # dry run
#   go run . -input ./risks.csv -migration-date 2026-09-15 -dry-run=false
#
# -input, -migration-date and -dry-run are deliberately left as flags, not
# vars here — passing them explicitly on every invocation is the point: which
# CSV, which date, and whether this run writes should never be a leftover
# value from an old .env.

# ── compliance-entity ────────────────────────────────────────────────────────
# Required. The entity this tool writes risks/users/grants/escalations through
# — never MySQL directly. Local: `go run ./cmd/api` in ../../entity/compliance-entity.
COMPLIANCE_ENTITY_BASE_URL=http://localhost:8080

# ── Asgardeo SCIM2 — live directory, email -> uuid ──────────────────────────
# Required. Same values the backend and cmd/backfill-uuids use (see
# apps/grc-platform/backend/.env.example) — this client only ever searches
# users, so only internal_user_mgt_view and internal_user_mgt_list are needed.
SCIM_BASE_URL=https://api.asgardeo.io
SCIM_INTERNAL_ORG=wso2
SCIM_INTERNAL_CLIENT_ID=
SCIM_INTERNAL_CLIENT_SECRET=
# Quoted: `source .env` runs this file as shell, and an unquoted space here
# parses as "assign SCIM_INTERNAL_SCOPES=internal_user_mgt_view, then run a
# command named internal_user_mgt_list" — silently NOT setting the full value.
SCIM_INTERNAL_SCOPES="internal_user_mgt_view internal_user_mgt_list"
# Optional override — derived as {SCIM_BASE_URL}/t/{SCIM_INTERNAL_ORG}/oauth2/token
# when left unset.
SCIM_TOKEN_URL=

# email-domain suffix ListUsersByDomain snapshots from SCIM. Defaults to
# wso2.com if left unset.
SCIM_DOMAIN=wso2.com

# ── misc ─────────────────────────────────────────────────────────────────────
# Per-request HTTP timeout (Go duration). Default 90s; SCIM cold-starts, keep
# it generous.
HTTP_TIMEOUT=
