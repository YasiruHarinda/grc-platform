# NOT IN USE on Choreo's React buildpack (see issue #90) — these VITE_
# values are substituted at build time, but Choreo's runtime configuration
# arrives after the build, so they'd be empty in the bundle. The current
# source of truth is public/config.js, read at page load; see
# public/config.js.example and README.md. This file is kept, with index.js
# and the Dockerfile, so the component can be switched back to the
# Dockerfile buildpack without a code change.
#
# Note that switching back does NOT bring these variables back into use.
# Nothing reads them any more — main.tsx reads window.config — so a
# Dockerfile deployment still needs public/config.js. They are retained only
# as a record of what the build-time configuration used to be.
#
# Frontend environment variables
# Copy this file to .env.local and fill in your values.

# Asgardeo OAuth application (build-time). Required — the web app fails to start
# if either is unset. Set them to your Asgardeo app's client id and tenant base URL.
VITE_ASGARDEO_CLIENT_ID=your-client-id-here
VITE_ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<your-org>
