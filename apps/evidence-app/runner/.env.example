# Runner environment variables
# Copy this file to .env and fill in your values.
# Alternatively run: wso2-runner configure --server https://<portal address>
# which fills in CLOUD_URL, ASGARDEO_ORG and ASGARDEO_CLIENT_ID below for you
# (fetched from that server), asks for your USER_EMAIL, and saves everything
# to ~/.wso2-runner/.env — updating the file in place rather than replacing it.

# Backend server URL (local dev, or the deployed Choreo/VM URL).
CLOUD_URL=http://localhost:8000

# Your WSO2 email — used as a login_hint on the Asgardeo sign-in page, and as
# the default user for `wso2-runner start` so it needs no email argument.
USER_EMAIL=

# Asgardeo tenant/org (same tenant as the web frontend and backend). Required.
ASGARDEO_ORG=
# Client ID of the Runner's own Asgardeo "Native Application" registration
# (public client, PKCE, no secret) — see the Asgardeo setup docs.
ASGARDEO_CLIENT_ID=

# LLM provider: azure | anthropic | gemini | ollama
AGENT_PROVIDER=azure
AGENT_MODEL=gpt-4.1-mini

# Azure OpenAI (used when AGENT_PROVIDER=azure)
# Normal path: run `az login` and set nothing below but ENDPOINT/DEPLOYMENT/TENANT_ID.
# The Runner then authorises every call with your own signed-in Azure identity —
# no key is written to disk, and none is needed.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
# How the Runner authorises Azure OpenAI calls: "entra" (default, normal path —
# uses your `az login` session) or "api_key" (rollout-period fallback only, see below).
AZURE_OPENAI_AUTH_MODE=entra
# Required when AZURE_OPENAI_AUTH_MODE=entra — pins your session to one Azure
# tenant so switching tenants for other work doesn't break LLM access.
AZURE_TENANT_ID=
# Only used, and only read, when AZURE_OPENAI_AUTH_MODE=api_key. This mode exists
# for the rollout period only and is scheduled for removal — do not set this on
# the normal path, and do not paste a key here unless you were told to use api_key mode.
AZURE_OPENAI_API_KEY=

# Anthropic (used when AGENT_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Optional: only for an Anthropic-compatible endpoint (e.g. Azure AI Foundry).
ANTHROPIC_BASE_URL=

# Gemini (used when AGENT_PROVIDER=gemini)
GEMINI_API_KEY=

# Browser channel: chrome | msedge | chromium
# Default "chrome" drives this machine's own Google Chrome, which must
# already be installed. Set to "chromium" to have the Runner download and
# use Playwright's own bundled browser instead (installed automatically).
BROWSER_CHANNEL=chrome

# Which monitor MSS captures for screenshots: 1 = primary, 2 = external.
SCREENSHOT_MONITOR=1
