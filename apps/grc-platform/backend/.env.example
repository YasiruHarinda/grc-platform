# Asgardeo JWT validation
# Derive from token endpoint: https://api.asgardeo.io/t/{org}/oauth2/token
AUTH_JWKS_ENDPOINT=
AUTH_ISSUER=
# Audience = your consumer key (client ID)
AUTH_AUDIENCE=
AUTH_TOKEN_VALIDATOR_ENABLED=

# Server
PORT=:8081

# Compliance Entity (data layer + Azure file storage)
COMPLIANCE_ENTITY_BASE_URL=http://localhost:8080

# HR entity GraphQL service (WSO2 employee lookup for Risk Identified By).
# Local: `go run ./cmd/hrmock`.
HR_ENTITY_GRAPHQL_URL=
HR_ENTITY_CLIENT_ID=
HR_ENTITY_CLIENT_SECRET=
HR_ENTITY_TOKEN_URL=

# SCIM Operations Service (digiops-infra/operations/scim-operations-service).
# The running server no longer needs this — it isn't read by internal/config
# any more — but cmd/backfill-grants (the one-time Asgardeo-group-to-grant
# migration tool) reads these same var names directly, for its own use.
# Only groups:read is needed — group membership is read via the
# groups-search endpoint's embedded "members" list, not the users-search
# endpoint (which needs a different, unused scope).
SCIM_BASE_URL=
SCIM_CLIENT_ID=
SCIM_CLIENT_SECRET=
SCIM_TOKEN_URL=
SCIM_SCOPES=org_internal:groups:read

# RISK_MANAGEMENT_GROUP / RISK_OWNER_GROUP are GONE. The Management Approver
# and Risk Owner pickers used to filter Asgardeo group membership over SCIM;
# they now read user_role_grant directly (GET /grants/candidates), the same
# table their approval actions check — so a picked candidate can no longer
# lack the grant and 403 on first use. Remove these two vars from any
# environment that still sets them — they are ignored.
#
# Not yet read by any handler — provisioned for the future Compliance Admin
# email notification (see notifyComplianceAdmins in risk/handler/notify.go,
# currently a deliberate no-op).
RISK_COMPLIANCE_ADMIN_GROUP=grc-platform-risk-compliance-admin

# Email notifications (email-service: POST /send-email). The service's own
# code has no auth check, but the real Choreo-hosted instance sits behind API
# Manager with OAuth2 client-credentials — same pattern as HR_ENTITY_* above.
EMAIL_SERVICE_URL=
EMAIL_FROM_ADDRESS=
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
EMAIL_TOKEN_URL=
# Public URL of the webapp — used to build the risk-detail link in emails,
# and as the CORS-allowed origin (there is no separate CORS_ALLOWED_ORIGIN
# var: both are the same "webapp's public origin", and having two meant one
# could be set correctly while the other silently defaulted elsewhere).
FRONTEND_BASE_URL=http://localhost:3000
