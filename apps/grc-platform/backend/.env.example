# Asgardeo JWT validation
# Derive from token endpoint: https://api.asgardeo.io/t/{org}/oauth2/token
AUTH_JWKS_ENDPOINT=
AUTH_ISSUER=
# Audience = your consumer key (client ID)
AUTH_AUDIENCE=
AUTH_TOKEN_VALIDATOR_ENABLED=
# Required (must be exactly "local") whenever AUTH_TOKEN_VALIDATOR_ENABLED=false.
# Disabling the validator skips signature verification AND turns every
# privilege check into allow-all, so config.Load() refuses to boot without
# this confirming the bypass is a developer's own machine. Leave unset in
# every deployed environment.
APP_ENV=

# Server
PORT=:8081

# Compliance Entity (data layer + Azure file storage)
COMPLIANCE_ENTITY_BASE_URL=http://localhost:8080

# HR entity GraphQL service (WSO2 employee lookup for Risk Identified By).
# Local: `go run ./cmd/hrmock`.
HR_ENTITY_GRAPHQL_URL=
HR_ENTITY_CLIENT_ID=
HR_ENTITY_CLIENT_SECRET=
HR_ENTITY_TOKEN_URL=

# Asgardeo SCIM2 — this platform's identity directory. Calls Asgardeo's own
# SCIM2 API directly (no digiops-infra SCIM Operations Service hop). The
# running server reads this via
# internal/config.SCIMConfig, to resolve a person's uuid to their name and
# email (see internal/directory and resolve.go) — required now that emails and
# display names are no longer stored in this database. cmd/backfill-uuids and
# the other backfill-* tools read the same var names directly for their own,
# offline use.
#
# Internal users and external auditors are genuinely separate Asgardeo
# organizations/app registrations — BASE_URL is the shared Asgardeo API root;
# everything else below is per-org. Only internal_user_mgt_view and
# internal_user_mgt_list are needed — this client only ever searches users.
SCIM_BASE_URL=https://api.asgardeo.io

SCIM_INTERNAL_ORG=wso2
SCIM_INTERNAL_CLIENT_ID=
SCIM_INTERNAL_CLIENT_SECRET=
# SCIM_INTERNAL_TOKEN_URL = https://api.asgardeo.io/t/{SCIM_INTERNAL_ORG}/oauth2/token
SCIM_INTERNAL_TOKEN_URL=https://api.asgardeo.io/t/wso2/oauth2/token
# Quoted: `source .env` runs this file as shell, and an unquoted space here
# parses as "assign SCIM_INTERNAL_SCOPES=internal_user_mgt_view, then run a
# command named internal_user_mgt_list" — silently NOT setting the full value.
SCIM_INTERNAL_SCOPES="internal_user_mgt_view internal_user_mgt_list"

SCIM_EXTERNAL_ORG=wso2external
SCIM_EXTERNAL_CLIENT_ID=
SCIM_EXTERNAL_CLIENT_SECRET=
# SCIM_EXTERNAL_TOKEN_URL = https://api.asgardeo.io/t/{SCIM_EXTERNAL_ORG}/oauth2/token
SCIM_EXTERNAL_TOKEN_URL=https://api.asgardeo.io/t/wso2external/oauth2/token
SCIM_EXTERNAL_SCOPES="internal_user_mgt_view internal_user_mgt_list"

# RISK_MANAGEMENT_GROUP / RISK_OWNER_GROUP / RISK_COMPLIANCE_ADMIN_GROUP are
# GONE. The Management Approver and Risk Owner pickers used to filter
# Asgardeo group membership over SCIM; they now read user_role_grant directly
# (GET /grants/candidates), the same table their approval actions check — so
# a picked candidate can no longer lack the grant and 403 on first use.
# notifyComplianceAdmins (risk/handler/notify.go) resolves the Compliance
# Admin email notification the same way — GET /grants/candidates for
# RISK_COMPLIANCE_APPROVE — rather than a group, for the same reason. Remove
# these three vars from any environment that still sets them — they are
# ignored.

# Email notifications (email-service: POST /send-email). The service's own
# code has no auth check, but the real Choreo-hosted instance sits behind API
# Manager with OAuth2 client-credentials — same pattern as HR_ENTITY_* above.
EMAIL_SERVICE_URL=
EMAIL_FROM_ADDRESS=
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
EMAIL_TOKEN_URL=
# Public URL of the webapp — used to build the risk-detail link in emails,
# and as the CORS-allowed origin (there is no separate CORS_ALLOWED_ORIGIN
# var: both are the same "webapp's public origin", and having two meant one
# could be set correctly while the other silently defaulted elsewhere).
FRONTEND_BASE_URL=http://localhost:3000
