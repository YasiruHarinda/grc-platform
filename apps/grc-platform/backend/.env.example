# Asgardeo JWT validation
# Derive from token endpoint: https://api.asgardeo.io/t/{org}/oauth2/token
AUTH_JWKS_ENDPOINT=
AUTH_ISSUER=
# Audience = your consumer key (client ID)
AUTH_AUDIENCE=
AUTH_TOKEN_VALIDATOR_ENABLED=

# IdP-2 (Evidence Portal; scope restricted to /api/v1/evidence-app/*) — OPTIONAL.
# Set AUTH_ISSUER_2 to enable a second issuer; when set, all four vars below are
# required. Tokens from this IdP are capped at the SUBMIT_EVIDENCE privilege ceiling
# regardless of AUTH_GROUP_ROLE_MAP_2. Leave AUTH_ISSUER_2 blank for single-IdP.
# AUTH_ISSUER_2=https://api.asgardeo.io/t/<their-org>/oauth2/token
# AUTH_JWKS_ENDPOINT_2=https://api.asgardeo.io/t/<their-org>/oauth2/jwks
# AUTH_AUDIENCE_2=<grc-backend-api-audience-in-their-org>
# Comma-separated ext=grc pairs mapping IdP-2 groups to GRC roles (unmapped groups dropped):
# AUTH_GROUP_ROLE_MAP_2=grc_evidence_submitter=audit_internal_team

# Server
PORT=:8081
# Frontend origin for CORS (defaults to http://localhost:3000 if not set)
CORS_ALLOWED_ORIGIN=http://localhost:3000

# Compliance Entity (data layer + Azure file storage)
COMPLIANCE_ENTITY_BASE_URL=http://localhost:8080

# HR entity GraphQL service (WSO2 employee lookup for Risk Identified By).
# Local: `go run ./cmd/hrmock`.
HR_ENTITY_GRAPHQL_URL=
HR_ENTITY_CLIENT_ID=
HR_ENTITY_CLIENT_SECRET=
HR_ENTITY_TOKEN_URL=

# SCIM Operations Service (digiops-infra/operations/scim-operations-service),
# same pattern as HR_ENTITY_* above. Only groups:read is needed — group
# membership is read via the groups-search endpoint's embedded "members"
# list, not the users-search endpoint (which needs a different, unused scope).
SCIM_BASE_URL=
SCIM_CLIENT_ID=
SCIM_CLIENT_SECRET=
SCIM_TOKEN_URL=
SCIM_SCOPES=org_internal:groups:read

# Email notifications (email-service: POST /send-email). The service's own
# code has no auth check, but the real Choreo-hosted instance sits behind API
# Manager with OAuth2 client-credentials — same pattern as HR_ENTITY_* above.
EMAIL_SERVICE_URL=
EMAIL_FROM_ADDRESS=
EMAIL_CLIENT_ID=
EMAIL_CLIENT_SECRET=
EMAIL_TOKEN_URL=
# Public URL of the webapp — used to build the risk-detail link in emails
FRONTEND_BASE_URL=http://localhost:3000
